generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url       = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  parentId  Int?
  sortOrder Int?
  // Sửa lỗi NVarChar
  slug      String?   @db.VarChar(100)
  // Sửa lỗi @default
  isActive  Boolean   @default(true)
  createdAt DateTime?
  updatedAt DateTime?
  // Sửa lỗi NVarChar
  urlImage  String?   @map("url_image") @db.VarChar(300)
  products  Product[]
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  // Sửa lỗi NVarChar
  slug        String?   @db.VarChar(200)
  // Sửa lỗi NVarChar
  logoUrl     String?   @map("logo_url") @db.VarChar(500)
  description String?
  products    Product[]
}

model Product {
  id             Int       @id @default(autoincrement())
  // Sửa lỗi NVarChar
  name           String    @db.VarChar(200)
  // Sửa lỗi NVarChar
  title          String?   @db.VarChar(300)
  // Sửa lỗi NVarChar
  alias          String    @unique @db.VarChar(200)
  // Sửa lỗi NVarChar
  sku            String    @unique @db.VarChar(50)
  price          Decimal   @db.Decimal(12, 2)
  compareAtPrice Decimal?  @map("compare_at_price") @db.Decimal(12, 2)
  // Sửa lỗi NVarChar
  description    String?   @db.VarChar(2000)
  // Sửa lỗi NVarChar
  imageUrl       String?   @map("image_url") @db.VarChar(500)
  rating         Decimal?  @default(5) @db.Decimal(2, 1)
  reviewCount    Int?      @default(0) @map("review_count")
  stock          Int?      @default(0)
  isActive       Boolean   @default(true) @map("is_active")
  categoryId     Int       @map("category_id")
  brandId        Int       @map("brand_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  images         Image[]
  brand          Brand     @relation(fields: [brandId], references: [id])
  category       Category  @relation(fields: [categoryId], references: [id])
  cartItems      CartItem[]
  orderItems     OrderItem[]
}

model Image {
  id        Int     @id @default(autoincrement())
  url       String
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model User {
  id             Int      @id @default(autoincrement())
  // Sửa lỗi NVarChar
  email          String   @unique @db.VarChar(255)
  // Sửa lỗi NVarChar
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  // Sửa lỗi NVarChar
  fullName       String?  @map("full_name") @db.VarChar(100)
  // Sửa lỗi NVarChar
  role           String   @default("CUSTOMER") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  cart           Cart?
  orders         Order[]
}

// Giỏ hàng - mỗi user có 1 cart
model Cart {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id])
  items     CartItem[]
}

// Sản phẩm trong giỏ hàng
model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId]) // Mỗi sản phẩm chỉ có 1 dòng trong cart
}

// Đơn hàng
model Order {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  // Sửa lỗi NVarChar
  status          String    @default("PENDING") @db.VarChar(20) // PENDING, CONFIRMED, SHIPPING, COMPLETED, CANCELLED
  totalAmount     Decimal   @map("total_amount") @db.Decimal(12, 2)
  // Sửa lỗi NVarChar
  shippingAddress String?   @map("shipping_address") @db.VarChar(500)
  // Sửa lỗi NVarChar
  phone           String?   @db.VarChar(20)
  // Sửa lỗi NVarChar
  note            String?   @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

// Chi tiết đơn hàng
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  price     Decimal @db.Decimal(12, 2) // Giá tại thời điểm đặt hàng
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}